#auth{max-width:400px;margin:0 auto;padding:12vh 24px 24px;text-align:center}
#auth h1{display:flex;align-items:center;justify-content:center;gap:16px;font-size:34px;font-weight:300;letter-spacing:.28em;margin:0 0 6px}#auth>p{letter-spacing:.1em;margin:0 0 36px}
#auth .card{margin-top:18px}
#app{display:flex;height:100%}
nav{width:236px;background:var(--sb);padding:34px 18px;display:flex;flex-direction:column;gap:2px;overflow:auto}
nav b{display:flex;align-items:center;gap:12px;font-size:21px;font-weight:300;letter-spacing:.28em;margin:0 0 34px 14px;color:#fff}
nav a{padding:11px 14px;border-radius:4px;cursor:pointer;color:var(--st);font-size:13px;letter-spacing:.1em;transition:all .15s}
nav a:hover{color:#fff}nav a.on{background:rgba(255,255,255,.12);color:#fff}
main{flex:1;overflow:auto;padding:44px 52px;max-width:940px}
.bal{font-size:58px;font-weight:200;letter-spacing:-.03em;line-height:1.1;color:var(--tx)}
.mu{color:var(--mu);font-size:13px}.pt{font-size:26px;font-weight:300;letter-spacing:.14em;margin:0 0 26px}main>*{animation:up .35s both}@keyframes up{from{opacity:0;transform:translateY(8px)}}.row:hover{background:rgba(127,127,127,.06)}.card{transition:border-color .2s}.card:hover{border-color:var(--mu)}.qa{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}:root[data-theme=dark]{--bg:#0a0a0a;--card:#141414;--tx:#eee;--mu:#888;--bd:#262626;--pr:#eee;--ok:#ccc;--ng:#aaa;--pt:#111;--sb:#000;--st:#8a8a8a}
.row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:15px 0;border-bottom:1px solid var(--bd)}.row:last-child{border-bottom:0}
.plus,.minus{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}.plus::before{content:""}.minus{color:var(--mu)}
.dot{background:#fff;color:#111;border-radius:99px;padding:0 7px;font-size:11px;margin-left:8px;font-weight:700}
#msg{position:fixed;top:calc(18px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);padding:13px 26px;border-radius:4px;color:var(--pt);z-index:30;display:none;font-size:14px;letter-spacing:.04em;box-shadow:0 8px 30px rgba(0,0,0,.25)}
#top,#ov{display:none}
@media(max-width:700px){#app{flex-direction:column}
#top{display:flex;align-items:center;gap:14px;padding:10px 16px;background:var(--sb);color:#fff;flex:0 0 auto}
#top button{background:none;border:0;padding:6px;cursor:pointer;display:flex;flex-direction:column;gap:5px}
#top button i{display:block;width:24px;height:2px;background:#fff;border-radius:2px}
#top span{font-size:17px;letter-spacing:.2em;font-weight:300}
nav{position:fixed;top:0;left:0;bottom:0;width:80%;max-width:300px;z-index:40;transform:translateX(-102%);transition:transform .25s;padding-top:calc(34px + env(safe-area-inset-top,0px));box-shadow:0 0 40px rgba(0,0,0,.4)}
body.nv nav{transform:none}body.nv #ov{display:block}
#ov{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:35}
nav a{padding:14px;font-size:15px}
main{padding:20px 16px 40px;max-width:100%}.pt{font-size:22px;margin-bottom:18px}.bal{font-size:40px}.card{padding:18px}
input,select{font-size:16px}.btn{padding:12px 16px}.row{flex-wrap:wrap}#auth{padding-top:8vh}}
</style></head><body>
<div id="msg"></div><div id="root">読み込み中…</div>
<script>
const LOGO="data:image/png;base64,",CODE_HASH="603846c905e0e50aa5823d9454b0f868c2b2840c17012aafd21c47418268e875",D=new Date;let db,me=null,page="home",admin=0,timer;
const $=s=>document.querySelector(s),yen=n=>"¥"+Number(n).toLocaleString(),fmt=t=>new Date(t).toLocaleString("ja-JP",{month:"numeric",day:"numeric",hour:"2-digit",minute:"2-digit"});
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const sha=async s=>[...new Uint8Array(await crypto.subtle.digest("SHA-256",new TextEncoder().encode(s)))].map(b=>b.toString(16).padStart(2,"0")).join("");
const key=n=>n.normalize("NFKC").trim().toLowerCase();
function say(t,ok=1){const m=$("#msg");m.textContent=t;m.style.background=ok?"var(--ok)":"var(--ng)";m.style.display="block";clearTimeout(say.t);say.t=setTimeout(()=>m.style.display="none",3500)}
const st=(k,v)=>{try{v===undefined?(localStorage.removeItem(k),sessionStorage.removeItem(k)):(v.keep?localStorage:sessionStorage).setItem(k,JSON.stringify(v))}catch(e){}};
const ld=k=>{try{return JSON.parse(localStorage.getItem(k)||sessionStorage.getItem(k))}catch(e){return null}};
const U=id=>db.collection("users").doc(id),all=async c=>(await db.collection(c).get()).docs.map(d=>({id:d.id,...d.data()}));
async function users(){return all("users")}
const NK={send:"req",log:"pay",loan:"loan",dm:"dm",event:"event",home:"news",ask:"reply",note:"reply",set:"sec"};
async function note(uid,text,to){try{const p=((await U(uid).get()).data()||{}).pf||{},k=NK[to]||"news";if(k!="sec"&&p.nt&&p.nt[k]===0)return}catch(e){}await db.collection("notes").add({uid,text,to,read:0,t:Date.now()})}
function localDb(){let D;try{D=JSON.parse(localStorage.getItem("lcdb")||"{}")}catch(e){D={}}const cp=o=>JSON.parse(JSON.stringify(o)),save=()=>{try{localStorage.setItem("lcdb",JSON.stringify(D))}catch(e){}};
 const doc=(c,id)=>({id,get:async()=>({id,data:()=>D[c]&&D[c][id]?cp(D[c][id]):undefined}),set:async d=>{(D[c]=D[c]||{})[id]=cp(d);save()},update:async d=>{Object.assign(D[c][id],d);save()},delete:async()=>{if(D[c])delete D[c][id];save()}});
 return{collection:c=>({doc:id=>doc(c,id),add:async d=>{const id="d"+Date.now().toString(36)+Math.random().toString(36).slice(2,7);(D[c]=D[c]||{})[id]=cp(d);save();return doc(c,id)},get:async()=>({docs:Object.entries(D[c]||{}).map(([id,d])=>({id,data:()=>cp(d)}))})})}}
function fail(e){const m=String((e&&e.message)||e||"不明なエラー"),r=$("#root");if(r&&r.textContent.trim()=="読み込み中…"){r.innerHTML=`<div id="auth"><h1>Life cat</h1><div class="card" style="text-align:left"><p>読み込めませんでした。</p><p class=mu>${esc(m)}</p><button class="btn big" onclick="location.reload()">再読み込み</button><button class="btn big s" onclick="askPerm()">権限を確認する</button></div></div>`}else say("エラー: "+m,0)}
const askPerm=async()=>{try{const p=await claude.use("permissions");await p.request();location.reload()}catch(e){say("権限の画面を開けませんでした",0)}};
window.addEventListener("unhandledrejection",e=>fail(e.reason));
async function init(){let t;try{await Promise.race([init0(),new Promise((_,r)=>{t=setTimeout(()=>r(new Error("接続に時間がかかっています。再読み込みしてください。")),15000)})])}catch(e){fail(e)}finally{clearTimeout(t)}}
async function init0(){
 db=null;try{db=typeof claude!="undefined"?await claude.use("db"):null}catch(e){}
 if(!db){if(typeof claude!="undefined")throw new Error("データに接続できませんでした。claude.aiにログインして、このページを開き直してください。");db=localDb()}
 const s=ld("sess");
 if(s&&Date.now()<s.exp){const d=await U(s.uid).get(),u=d.data();
  if(u&&!u.banned&&u.hash===s.h){me={id:s.uid,...u};s.exp=Date.now()+5184e6;st("sess",s);return app()}}
 st("sess");authView()}
function authView(){$("#root").innerHTML=`<div id="auth"><h1><img src="${LOGO}" alt="" style="width:60px;height:60px;border-radius:14px">Life cat</h1><p class="mu">仮想のお金で学ぶ、お金の管理</p>
<button class="btn big" onclick="showForm('in')">ログイン</button><button class="btn big g" onclick="showForm('up')">新規入会</button><div id="f"></div></div>`}
function showForm(m){const up=m=="up";$("#f").innerHTML=`<div class="card" style="text-align:left"><label>ニックネーム</label><input id="n" maxlength="12" autocomplete="username">
${up?'<p class="mu">⚠ 本名・学校名は入れないでね(2〜12文字)</p>':""}<label>パスワード</label><input id="p" type="password" autocomplete="current-password">
${up?'<label>パスワード(もう一度)</label><input id="p2" type="password">':''}
<button class="btn" style="width:100%;margin-top:10px" onclick="${up?"signup()":"login()"}">${up?"入会する":"ログイン"}</button></div>`}
async function signup(){const n=$("#n").value.trim(),p=$("#p").value;
 if(n.length<2||n.length>12||!/[\p{L}\p{N}]/u.test(n))return say("ニックネームは2〜12文字で、文字か数字を含めてください",0);
 if(p.length<6)return say("パスワードは6文字以上で設定してください",0);if(p!==$("#p2").value)return say("パスワードが一致しません",0);
 const k=key(n),ex=await U("n_"+k).get();if(ex.data())return say("そのニックネームは使われています",0);
 const h=await sha(k+":"+p);await U("n_"+k).set({nick:n,k,hash:h,bal:0,created:Date.now(),banned:0});st("sess",{uid:"n_"+k,h,exp:Date.now()+5184e6,keep:true});me={id:"n_"+k,nick:n,k,hash:h,bal:0,created:Date.now(),banned:0};say("入会できました!");app()}
async function login(){const n=$("#n").value,p=$("#p").value,k=key(n),d=await U("n_"+k).get(),u=d.data(),h=await sha(k+":"+p);
 if(!u||u.hash!==h)return say("ニックネームかパスワードが違います",0);if(u.banned)return say("このアカウントは停止されています",0);
 st("sess",{uid:"n_"+k,h,exp:Date.now()+5184e6,keep:true});me={id:"n_"+k,...u};try{await db.collection("logins").add({uid:me.id,t:Date.now(),ua:navigator.userAgent.slice(0,90)})}catch(e){}app()}
function logout(){st("sess");me=null;admin=0;document.body.classList.remove("nv");document.documentElement.removeAttribute("data-theme");document.documentElement.style.cssText="";clearInterval(timer);authView();showForm("in")}
async function app(){$("#root").innerHTML=`<div id="app"><div id="top"><button onclick="document.body.classList.toggle('nv')" aria-label="メニュー"><i></i><i></i><i></i></button><span>Life cat</span></div><div id="ov" onclick="document.body.classList.remove('nv')"></div><nav id="nav"></nav><main id="main"></main></div>`;go("home");dueCheck();clearInterval(timer);timer=setInterval(()=>{if(!["send","set","code","dm","ask","loan"].includes(page))go(page,1)},15000)}
async function go(p,quiet){page=p;if(!quiet)document.body.classList.remove("nv");const d=await U(me.id).get();if(!d.data())return logout();me={id:me.id,...d.data()};applyPf();
 if(me.banned)return logout();const ns=(await all("notes")).filter(n=>n.uid==me.id),un=ns.filter(n=>!n.read).length;
 const M=[["home","","マイページ"],["send","","送金・請求"],["loan","","借金・返済"],["log","","通帳"],["dm","","DM"],["note","","通知"+(un?`<span class=dot>${un}</span>`:"")],["event","","イベント"],["ask","","お問い合わせ・通報"],["set","","設定"],["code","","コード"]];
 $("#nav").innerHTML="<b><img src='"+LOGO+"' alt='' style='width:34px;height:34px;border-radius:8px'>Life cat</b>"+M.map(m=>`<a class="${m[0]==p?"on":""} ${m[0]=="set"||m[0]=="code"?"x":""}" onclick="go('${m[0]}')">${m[1]} ${m[2]}</a>`).join("")+`<a onclick="logout()" class=x>ログアウト</a>`;
 if(quiet&&["send","set","code"].includes(p))return;
 const tt=(M.find(m=>m[0]==p)||[0,0,""])[2].replace(/<[^>]*>/g,"");$("#main").innerHTML=`<h2 class=pt>${tt}</h2>`+await V[p](ns)}
const V={
async home(ns){const dbt=(await all("loan")).filter(l=>l.borrower==me.id&&l.st=="on").reduce((s,l)=>s+l.amt-l.paid,0);const rq=(await all("req")).filter(r=>r.to==me.id&&r.st=="wait"),t=await mytx();
 return`<div class="card"><div class="mu">${esc(me.nick)}さんの残高</div><div class="bal">${yen(me.bal)}</div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--bd)"><span class="mu">借金の残り</span> <b style="font-size:20px;margin-left:8px">${yen(dbt)}</b></div></div>
 <div class="card"><b>届いている請求</b>${rq.length?rq.map(rqRow).join(""):'<p class="mu">ありません</p>'}</div>
 <div class="qa"><button class="btn" onclick="go('send')">送金・請求</button><button class="btn s" onclick="go('loan')">借金・返済</button><button class="btn s" onclick="go('dm')">DM</button></div>${spark(t)}<div class="card"><b>最近の取引</b>${txRows(t.slice(0,5))}</div>
 <div class="card"><b>未読通知</b>${ns.filter(n=>!n.read).slice(0,3).map(n=>`<div class=row>${esc(n.text)}</div>`).join("")||'<p class="mu">ありません</p>'}</div>`},
async send(){const rq=(await all("req")).filter(r=>r.to==me.id&&r.st=="wait");
 return`<div class="card"><b>送金する / 請求する</b><label>相手を選ぶ</label>${await pickU("to")}<label>金額(円)</label><input id="amt" type="number" min="1" inputmode="numeric"><label>理由</label><input id="why" maxlength="40"><label>返済予定日(任意・請求用)</label><input id="rd" type="date"><p class="mu" style="margin:0 0 14px">請求に相手が同意すると、返済が必要な借金になります。</p>
 <button class="btn" onclick="sendMoney()">送金</button> <button class="btn g" onclick="makeReq()">請求</button></div>
 <div class="card"><b>届いている請求</b>${rq.length?rq.map(rqRow).join(""):'<p class="mu">ありません</p>'}</div>`},
async log(){return`<div class="card"><b>通帳</b>${txRows(await mytx())}</div>`},
async note(ns){ns.sort((a,b)=>b.t-a.t);for(const n of ns.filter(n=>!n.read))db.collection("notes").doc(n.id).update({read:1});
 return`<div class="card"><b>通知</b>${ns.map(n=>`<div class=row onclick="go('${n.to||"home"}')" style="cursor:pointer"><span>${n.read?"":"🔴 "}${esc(n.text)}</span><span class=mu>${fmt(n.t)}</span></div>`).join("")||'<p class="mu">ありません</p>'}</div>`},
async set(){return`<div class="card"><b>パスワード変更</b><input id="op" type="password" placeholder="今のパスワード"><input id="np" type="password" placeholder="新しいパスワード(6文字以上)"><button class="btn" onclick="chpw()">変更</button></div>
 <div class="card"><button class="btn r" onclick="logout()">ログアウト</button></div>`},
async code(){if(admin&&Date.now()<admin)return adminView();admin=0;return`<div class="card"><b>管理者コード</b><input id="cd" type="password" inputmode="numeric"><button class="btn" onclick="chk()">確認</button></div>`}};
async function mytx(){const t=(await all("tx")).filter(x=>x.from==me.id||x.to==me.id);return t.sort((a,b)=>b.t-a.t)}
function txRows(t){return t.map(x=>{const out=x.from==me.id,o=out?x.toN:x.fromN;return`<div class=row><div>${esc(o)} <span class=mu>${esc(x.why||"")}</span><br>${sgi(x.rsig,"請求者のサイン")}${sgi(x.sig,"支払い者のサイン")}<span class=mu>${fmt(x.t)} ・No.${x.id.slice(0,8)}</span></div><div class="${out?"minus":"plus"}">${out?"-":"+"}${yen(x.amt)}</div></div>`}).join("")||'<p class="mu">まだ取引がありません</p>'}
function rqRow(r){return`<div class=row><div>${esc(r.fromN)}さんから ${yen(r.amt)}${r.loan?" 【借金】":""}<br><span class=mu>${esc(r.why||"")}</span>${String(r.sig||"").startsWith("data:image/png")?`<br><img src="${r.sig}" alt="署名" style="height:38px;background:#fff;border:1px solid var(--bd)">`:""}</div><div><button class="btn g" onclick="ans('${r.id}',1)">同意</button> <button class="btn r" onclick="ans('${r.id}',0)">拒否</button></div></div>`}
async function find(n){const k=key(n),d=await U("n_"+k).get(),u=d.data();return u?{id:"n_"+k,...u}:null}
async function pay(from,to,amt,why,rid,sig,rsig){const a=await U(from.id).get(),b=await U(to.id).get();
 if(a.data().bal<amt)throw"残高が足りません";await U(from.id).update({bal:a.data().bal-amt});await U(to.id).update({bal:b.data().bal+amt});
 await db.collection("tx").add({from:from.id,fromN:from.nick,to:to.id,toN:to.nick,amt,why,rid:rid||"",sig:sig||"",rsig:rsig||"",t:Date.now()})}
function chkIn(u,a){if(!u)throw"そのニックネームの人はいません";if(u.id==me.id)throw"自分には使えません";if(u.banned)throw"その人は利用できません";if(!Number.isInteger(a)||a<1||a>1e7)throw"金額は1円以上の整数にしてね"}
let busy=0;
async function sendMoney(){if(busy)return;busy=1;try{const a=+$("#amt").value,u=await find($("#to").value);chkIn(u,a);
 if(PF().cf!==0&&!confirm(`【送金の確認】\n相手:${u.nick}\n金額:${yen(a)}\n理由:${$("#why").value||"なし"}\n\nこの内容でよろしいですか?`))return;const sg=await sign(`${u.nick}さんへ ${yen(a)} を支払います`);if(!sg)return;await pay(me,u,a,$("#why").value,"",sg);await note(u.id,`${me.nick}さんから ${yen(a)} 届きました`,"log");say("送金しました!");go("send")}catch(e){say(String(e),0)}finally{busy=0}}
async function makeReq(){if(busy)return;busy=1;try{const a=+$("#amt").value,u=await find($("#to").value);chkIn(u,a);
 const sg=await sign(`${u.nick}さんへ ${yen(a)} を借金として請求します`);if(!sg)return;await db.collection("req").add({sig:sg,loan:1,due:$("#rd").value?new Date($("#rd").value).getTime():0,from:me.id,fromN:me.nick,to:u.id,toN:u.nick,amt:a,why:$("#why").value,st:"wait",t:Date.now()});await note(u.id,`${me.nick}さんから ${yen(a)} の請求が届きました`,"send");say("請求を送りました")}catch(e){say(String(e),0)}finally{busy=0}}
async function ans(id,ok){if(busy)return;busy=1;try{const ref=db.collection("req").doc(id),r=(await ref.get()).data();
 if(!r||r.st!="wait"||r.to!=me.id)throw"この請求は処理済みです";
