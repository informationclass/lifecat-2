*{box-sizing:border-box}html,body{height:100%;margin:0;max-width:100%;overflow-x:hidden;-webkit-text-size-adjust:100%}img,svg,canvas,video{max-width:100%}main,.card,.row>*{min-width:0}.row>div{overflow-wrap:anywhere}
body{background:var(--bg);color:var(--tx);font:15px/1.7 "Helvetica Neue",Helvetica,"Hiragino Kaku Gothic ProN","Noto Sans JP",sans-serif;-webkit-font-smoothing:antialiased}
button,input,select{font:inherit}a[onclick^="rep("]{display:none}select{width:100%;padding:12px 14px;margin:6px 0 14px;border:1px solid var(--bd);border-radius:4px;background:var(--card);color:var(--tx);outline:0}
input{width:100%;padding:12px 14px;margin:6px 0 14px;border:1px solid var(--bd);border-radius:4px;background:var(--card);color:var(--tx);outline:0;transition:border-color .15s}
input:focus{border-color:var(--tx)}label{font-size:12px;letter-spacing:.08em;color:var(--mu)}
.btn{background:var(--pr);color:var(--pt);border:1px solid var(--pr);border-radius:4px;padding:11px 22px;cursor:pointer;font-weight:600;font-size:14px;letter-spacing:.06em;transition:opacity .15s}
.btn:hover{opacity:.8}.btn.s{background:transparent;color:var(--tx);border-color:var(--bd)}.btn.g{background:var(--pr);color:var(--pt)}.btn.r{background:transparent;color:var(--tx);border-color:var(--tx)}
.btn.big{width:100%;padding:17px;font-size:15px;margin:8px 0;letter-spacing:.14em}
