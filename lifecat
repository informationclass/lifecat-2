<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8"><title>Life cat</title>
<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, viewport-fit=cover">
<style>
:root{--bg:#f6f6f4;--card:#fff;--tx:#111;--mu:#8a8a8a;--pr:#111;--ok:#2b2b2b;--ng:#555;--bd:#e4e4e0;--pt:#fff;--sb:#111;--st:#a8a8a8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
